# ── Same Neon database as the web app ─────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth (separate secret from the web app) ────────────────────────────
NEXTAUTH_SECRET="a-different-secret-from-the-web-app"
NEXTAUTH_URL="http://localhost:3001"

# ── Blockchain (same key, same contract) ──────────────────────────────────
# NEVER commit — Vercel Environment Variables only
FUJI_MINTER_PRIVATE_KEY="0x..."
