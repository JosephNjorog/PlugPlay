# ── Neon PostgreSQL ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
# On Vercel, NEXTAUTH_URL is auto-set — you can omit it

# ── Pusher (for Arena real-time) ───────────────────────────────────────────
PUSHER_APP_ID="your-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="us2"
# Client-side (safe to expose):
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# ── Avalanche / Blockchain ─────────────────────────────────────────────────
# NEVER commit this key — store in Vercel Environment Variables only
# Must be a funded Fuji wallet for gas
FUJI_MINTER_PRIVATE_KEY="0x..."

# ── Luma (optional — for event check-in sync) ─────────────────────────────
# NEVER commit this key
LUMA_API_KEY="luma_..."
